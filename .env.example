# PRAHARI v9.4 — example configuration. Copy to .env and change secrets.
PRAHARI_ENV=development

# Set true before any shared/deployed use. v9.5 has separate Admin and Field Officer portals.
PRAHARI_AUTH_REQUIRED=true
PRAHARI_OPERATOR_KEY=change-me-operator
PRAHARI_REVIEWER_KEY=change-me-reviewer
PRAHARI_ADMIN_KEY=admin-01  # Admin Portal key

# Browser origins allowed to call the API.
PRAHARI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional database path. Default: backend/prahari.db
# PRAHARI_DB_PATH=C:\\path\\to\\prahari.db

# Weather provider resilience.
PRAHARI_WEATHER_TIMEOUT_SECONDS=4
PRAHARI_WEATHER_CACHE_TTL_SECONDS=300
PRAHARI_WEATHER_STALE_MAX_SECONDS=21600

# Evidence upload limit in bytes (default 2 MB).
PRAHARI_MAX_UPLOAD_BYTES=2097152

# -----------------------------------------------------------------------------
# External text SMS delivery (Twilio)
# -----------------------------------------------------------------------------
# Keep false until credentials/sender are configured and recipients have opted in.
PRAHARI_SMS_ENABLED=true
PRAHARI_NOTIFICATION_PROVIDER=twilio

# Twilio server-side credentials. Never put these in frontend/.env.
PRAHARI_TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
PRAHARI_TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN

# Use either a Twilio sender number OR a Messaging Service SID.
# For India production SMS, complete any applicable DLT/sender registration first.
PRAHARI_TWILIO_SMS_FROM=YOUR_TWILIO_SMS_NUMBER
# PRAHARI_TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Needed for Twilio delivery status callbacks. This must be a PUBLIC HTTPS URL.
# PRAHARI appends /api/notification/twilio/status.
PRAHARI_PUBLIC_BASE_URL=
PRAHARI_TWILIO_VALIDATE_SIGNATURE=true

# -----------------------------------------------------------------------------
# Field-officer civilian enrollment
# -----------------------------------------------------------------------------
# Each Field Officer Portal login uses officer_code + a unique access key and exactly one monitored posting.
# location_id values currently map to: 1 Gangtok, 2 Aizawl, 3 Kohima, 4 Shillong,
# 5 Itanagar, 6 Imphal East, 7 Dima Hasao, 8 Unakoti.
# Keep this JSON server-side only; never expose it in Vite/frontend environment files.
PRAHARI_FIELD_OFFICERS_JSON=[{"name":"Field Officer Gangtok","officer_code":"FO-GTK-01","location_id":1,"key":"gangtok-01"},{"name":"Field Officer Aizawl","officer_code":"FO-AIZ-01","location_id":2,"key":"aizawl-01"},{"name":"Field Officer Kohima","officer_code":"FO-KOH-01","location_id":3,"key":"kohima-01"},{"name":"Field Officer Shillong","officer_code":"FO-SHL-01","location_id":4,"key":"shillong-01"},{"name":"Field Officer Itanagar","officer_code":"FO-ITA-01","location_id":5,"key":"itanagar-01"},{"name":"Field Officer Imphal East","officer_code":"FO-IMP-01","location_id":6,"key":"imphal-east-01"},{"name":"Field Officer Dima Hasao","officer_code":"FO-DIM-01","location_id":7,"key":"dima-hasao-01"},{"name":"Field Officer Unakoti","officer_code":"FO-UNA-01","location_id":8,"key":"unakoti-01"}]
